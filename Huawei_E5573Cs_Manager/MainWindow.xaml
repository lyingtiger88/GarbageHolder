<Window x:Class="ModemManagerNative.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Huawei E5573Cs Manager" Height="860" Width="1320"
        MinHeight="760" MinWidth="1120"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel>
                <TextBlock Text="E5573Cs MANAGER" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>
                <Button Content="Refresh dashboard" Click="RefreshHuawei_Click" Margin="0,3"/>
                <Button Content="Detect Huawei modem" Click="DetectHuawei_Click" Margin="0,3"/>
                <Button Content="Open admin panel" Click="OpenAdmin_Click" Margin="0,3"/>
                <Button Content="Ping gateway" Click="Ping_Click" Margin="0,3"/>
                <Button Content="Copy gateway IP" Click="CopyGateway_Click" Margin="0,3"/>

                <Separator Margin="0,14"/>
                <TextBlock Text="Huawei login" FontWeight="SemiBold" Margin="4,0,4,4"/>
                <TextBlock Text="Username" Margin="4,3,4,0"/>
                <TextBox x:Name="HuaweiUserBox" Text="admin" Margin="4"/>
                <TextBlock Text="Admin password" Margin="4,3,4,0"/>
                <PasswordBox x:Name="HuaweiPasswordBox" Margin="4"/>
                <Button Content="Login" Click="HuaweiLogin_Click" Margin="4,5"/>
                <TextBlock x:Name="LoginStateText" Text="Not logged in" Margin="4" Opacity="0.75"/>

                <Separator Margin="0,14"/>
                <TextBlock Text="Controls" FontWeight="SemiBold" Margin="4,0,4,4"/>
                <Button Content="Mobile data ON" Click="MobileDataOn_Click" Margin="4,3"/>
                <Button Content="Mobile data OFF" Click="MobileDataOff_Click" Margin="4,3"/>
                <Button Content="Reboot modem" Click="Reboot_Click" Margin="4,3"/>
                <TextBlock Text="Admin password is kept only in the password box and is never written to disk." TextWrapping="Wrap" Opacity="0.68" Margin="4,8"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Default Gateway" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GatewayText" Text="-" FontSize="22" Margin="0,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Local IPv4" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LocalIpText" Text="-" FontSize="22" Margin="0,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Wi-Fi SSID" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SsidText" Text="-" FontSize="22" Margin="0,4" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Admin address" FontWeight="SemiBold"/>
                        <TextBox x:Name="AdminUrlBox" Text="http://192.168.8.1" Margin="0,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Gateway latency" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LatencyText" Text="Not tested" FontSize="20" Margin="4,7"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Model" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ModelText" Text="-" FontSize="17" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Connection" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ConnectionText" Text="-" FontSize="17" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Network / Signal" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NetworkSignalText" Text="-" FontSize="17" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Battery / Clients" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BatteryClientsText" Text="-" FontSize="17" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="6" x:Name="MainTabs">
                <TabItem Header="Wi-Fi clients">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="Refresh clients" Click="RefreshClients_Click" Margin="0,0,8,0"/>
                                <Button Content="Disconnect selected" Click="DisconnectClient_Click" Margin="0,0,8,0"/>
                                <Button Content="Add to blacklist" Click="BlacklistClient_Click" Margin="0,0,12,0"/>
                                <TextBlock x:Name="WifiDetailsText" VerticalAlignment="Center" Opacity="0.78"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid Grid.Row="2" x:Name="ClientsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding HostName}" Width="*"/>
                                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="135"/>
                                <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="155"/>
                                <DataGridTextColumn Header="Connected time" Binding="{Binding ConnectedTimeDisplay}" Width="115"/>
                                <DataGridTextColumn Header="Upload" Binding="{Binding UploadDisplay}" Width="105"/>
                                <DataGridTextColumn Header="Download" Binding="{Binding DownloadDisplay}" Width="105"/>
                                <DataGridTextColumn Header="Total usage" Binding="{Binding TotalUsageDisplay}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Grid.Row="4">
                            <TextBlock Text="Blacklist" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="Refresh blacklist" Click="RefreshBlacklist_Click" Margin="8,0,8,0"/>
                                <Button Content="Remove selected" Click="RemoveBlacklist_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid Grid.Row="6" x:Name="BlacklistGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding HostName}" Width="*"/>
                                <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="210"/>
                                <DataGridTextColumn Header="SSID index" Binding="{Binding SsidIndex}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Traffic">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <Button Content="Refresh traffic" Click="RefreshTraffic_Click" DockPanel.Dock="Left"/>
                            <TextBlock Text="Quarter history is tracked locally by this app from the first observation; it is not retroactive."
                                       Margin="14,0,0,0" VerticalAlignment="Center" Opacity="0.68" TextWrapping="Wrap"/>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Header="Current session" Grid.Column="0" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Time" Grid.Row="0"/>
                                    <TextBlock x:Name="SessionTimeText" Text="-" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Text="Upload" Grid.Row="1"/>
                                    <TextBlock x:Name="SessionUploadText" Text="-" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Download" Grid.Row="2"/>
                                    <TextBlock x:Name="SessionDownloadText" Text="-" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Total" Grid.Row="3"/>
                                    <TextBlock x:Name="SessionTotalText" Text="-" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Text="Upload rate" Grid.Row="4"/>
                                    <TextBlock x:Name="UploadRateText" Text="-" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Download rate" Grid.Row="5"/>
                                    <TextBlock x:Name="DownloadRateText" Text="-" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Current month" Grid.Column="2" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Duration" Grid.Row="0"/>
                                    <TextBlock x:Name="MonthTimeText" Text="-" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Text="Upload" Grid.Row="1"/>
                                    <TextBlock x:Name="MonthUploadText" Text="-" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Download" Grid.Row="2"/>
                                    <TextBlock x:Name="MonthDownloadText" Text="-" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Total" Grid.Row="3"/>
                                    <TextBlock x:Name="MonthTotalText" Text="-" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Lifetime modem counters" Grid.Column="4" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Time" Grid.Row="0"/>
                                    <TextBlock x:Name="TotalTimeText" Text="-" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Text="Upload" Grid.Row="1"/>
                                    <TextBlock x:Name="TotalUploadText" Text="-" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Download" Grid.Row="2"/>
                                    <TextBlock x:Name="TotalDownloadText" Text="-" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Total" Grid.Row="3"/>
                                    <TextBlock x:Name="GrandTotalText" Text="-" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                            </GroupBox>
                        </Grid>

                        <TextBlock Grid.Row="4" Text="Quarterly modem-wide traffic (local tracking)"
                                   FontSize="17" FontWeight="SemiBold"/>

                        <DataGrid Grid.Row="6" x:Name="QuarterTrafficGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Quarter" Binding="{Binding Quarter}" Width="*"/>
                                <DataGridTextColumn Header="Upload" Binding="{Binding UploadDisplay}" Width="160"/>
                                <DataGridTextColumn Header="Download" Binding="{Binding DownloadDisplay}" Width="160"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="SMS">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.75*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <ComboBox x:Name="SmsBoxCombo" Width="110" SelectedIndex="0" Margin="0,0,8,0">
                                        <ComboBoxItem Content="Inbox"/>
                                        <ComboBoxItem Content="Sent"/>
                                        <ComboBoxItem Content="Drafts"/>
                                    </ComboBox>
                                    <Button Content="Refresh" Click="RefreshSms_Click" Margin="0,0,8,0"/>
                                    <Button Content="Mark read" Click="MarkSmsRead_Click" Margin="0,0,8,0"/>
                                    <Button Content="Delete" Click="DeleteSms_Click" Margin="0,0,8,0"/>
                                </StackPanel>
                                <TextBlock x:Name="SmsCountText" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.75"/>
                            </DockPanel>

                            <DataGrid Grid.Row="2" x:Name="SmsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionChanged="SmsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="State" Binding="{Binding ReadState}" Width="80"/>
                                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="150"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="155"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Preview}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBox Grid.Row="4" x:Name="SmsBodyBox" IsReadOnly="True" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8"/>
                        </Grid>

                        <Border Grid.Column="2" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="New SMS" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="Phone number" Margin="0,12,0,3"/>
                                <TextBox Grid.Row="2" x:Name="SmsPhoneBox"/>
                                <TextBox Grid.Row="3" x:Name="SmsComposeBox" Margin="0,10,0,0" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="SmsComposeBox_TextChanged"/>
                                <DockPanel Grid.Row="4" Margin="0,6,0,0">
                                    <TextBlock Text="Single-message limit is chosen automatically for GSM/Unicode." Opacity="0.65" FontSize="11"/>
                                    <TextBlock x:Name="SmsCharCountText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Button Grid.Row="5" x:Name="SendSmsButton" Content="Send SMS" Click="SendSms_Click" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Activity log">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Button Content="Clear" Click="ClearLog_Click" Margin="0,0,6,0"/>
                            <Button Content="Export" Click="ExportLog_Click"/>
                        </StackPanel>
                        <TextBox Grid.Row="2" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 AcceptsReturn="True" FontFamily="Consolas"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
